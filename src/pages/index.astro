---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>FlightLab</h1>
			<p>
				I'm Jason Scott — a wireless network engineer who builds autonomous systems for fun.
				FlightLab is where I write up that work: the RF, the edge AI, the flight control, and the
				engineering decisions behind an AI-piloted drone built from the ground up.
			</p>
			<p>
				Two threads run through most of what's here:
			</p>
			<ul>
				<li>
					<strong>Wireless &amp; RF</strong> — multi-band coexistence, link budgets, and keeping a
					safety-critical control link clean in a crowded spectrum. The day-job discipline, applied to
					something that flies.
				</li>
				<li>
					<strong>Edge AI &amp; autonomy</strong> — real-time computer vision, closed-loop control, and
					companion-computer-to-autopilot integration on constrained hardware.
				</li>
			</ul>
			<p>
				The throughline is systems integration done with a safety-first mindset — because the fun part
				is making independent subsystems work together without any one of them being allowed to do
				something dumb.
			</p>

			<h2>Latest posts</h2>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="post-date"> — <FormattedDate date={post.data.pubDate} /></span>
						</li>
					))
				}
			</ul>
			<p><a href="/blog/">All posts →</a></p>
		</main>
		<Footer />
	</body>
	<style>
		main { max-width: 720px; }
		.post-list { list-style: none; padding: 0; }
		.post-list li { margin-bottom: 0.5rem; }
		.post-date { color: rgb(var(--gray)); font-size: 0.9em; }
	</style>
</html>
